<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- SQLite is test-only (real-transaction UoW tests); its native
         e_sqlite3 bundle carries a known NU1903 advisory with no test impact. -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.7" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AsistOff.MES.Shared.Abstractions\AsistOff.MES.Shared.Abstractions.csproj" />
    <ProjectReference Include="..\..\AsistOff.MES.Shared.Infrastructure\AsistOff.MES.Shared.Infrastructure.csproj" />
    <ProjectReference Include="..\..\AsistOff.MES.Multitenancy\AsistOff.MES.Multitenancy.csproj" />
    <ProjectReference Include="..\..\AsistOff.MES.Multitenancy.Contracts\AsistOff.MES.Multitenancy.Contracts.csproj" />
    <ProjectReference Include="..\..\AsistOff.MES.Configuration.Application\AsistOff.MES.Configuration.Application.csproj" />
    <ProjectReference Include="..\..\AsistOff.MES.Configuration.Core\AsistOff.MES.Configuration.Core.csproj" />
    <ProjectReference Include="..\..\AsistOff.MES.Production.Application\AsistOff.MES.Production.Application.csproj" />
    <ProjectReference Include="..\..\AsistOff.MES.Production.Core\AsistOff.MES.Production.Core.csproj" />
    <ProjectReference Include="..\..\AsistOff.MES.Production.Infrastructure\AsistOff.MES.Production.Infrastructure.csproj" />
    <ProjectReference Include="..\..\AsistOff.MES.Users.Application\AsistOff.MES.Users.Application.csproj" />
    <ProjectReference Include="..\..\AsistOff.MES.Users.Core\AsistOff.MES.Users.Core.csproj" />
    <ProjectReference Include="..\..\AsistOff.MES.Attachments.Application\AsistOff.MES.Attachments.Application.csproj" />
    <ProjectReference Include="..\..\AsistOff.MES.Attachments.Core\AsistOff.MES.Attachments.Core.csproj" />
  </ItemGroup>

</Project>
