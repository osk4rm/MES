# API Configuration
# Matches the backend `http` launch profile (http://localhost:5243) used by
# scripts/e2e/app.ps1. The script also exports VITE_API_BASE_URL explicitly,
# so the e2e run always uses the backend URL it started (process env wins
# over this file). Keep this default in sync with the `http` profile.
VITE_API_BASE_URL=http://localhost:5243/

# Development settings
VITE_NODE_ENV=development
