  display: flex;
  gap: 1rem;
  align-items: center;
  flex-wrap: wrap;
}

.filter-input {
  padding: 0.5rem 0.75rem;
  border: 1px solid rgba(252, 145, 58, 0.3);
  border-radius: 6px;
  background: rgba(35, 39, 43, 0.7);
  color: #ffe066;
  font-size: 0.9rem;
  transition: all 0.2s ease;
  min-width: 200px;
}

.filter-input:focus {
  outline: none;
  border-color: #fc913a;
