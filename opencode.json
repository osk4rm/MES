{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "instructions": [
    "AGENT.md",
    ".github/copilot-instructions.md",
    "docs/glossary.md"
  ],
  "permission": {
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny"
    },
    "edit": "allow",
    "external_directory": "allow",
    "webfetch": "allow",
    "websearch": "allow"
  }
}
