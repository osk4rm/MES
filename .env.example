# Copy this file to .env and adjust values as needed.
# docker compose will automatically load .env from the project root.

# PostgreSQL credentials (defaults match appsettings.json dev values)
POSTGRES_DB=mes
POSTGRES_USER=admin
POSTGRES_PASSWORD=root

# URL at which the API is reachable from the *browser* (not from inside Docker).
# Override if you expose the API on a different host port.
VITE_API_BASE_URL=http://localhost:8080

# Seq (structured logging)
# Browse logs at http://localhost:${SEQ_PORT}
SEQ_PORT=5341

# --- Agent swarm (docker compose service `swarm`) ---
# GitHub token for gh + git push inside the container.
# Scopes: repo, workflow. Print the current one with: gh auth token
GH_TOKEN=

# Optional swarm overrides
# SWARM_REPO_URL=https://github.com/osk4rm/MES.git
# SWARM_REPO_BRANCH=master
# SWARM_AUTOSTART_DISPATCHER=1
# DASHBOARD_PORT=5178
