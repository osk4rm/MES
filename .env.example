# Copy this file to .env and generate secrets before the first boot:
#   cp .env.example .env && sh scripts/generate-env.sh
# docker compose loads .env from the project root automatically.
# NEVER commit .env — it holds generated production secrets.
#
# Server deployment (Coolify, same model as asiki): set the variables marked
# SERVER below in the Coolify UI (Environment Variables) instead of a file.
# Full guide: docs/deployment.md.

# PostgreSQL identity (non-secret defaults are fine).
POSTGRES_DB=mes
POSTGRES_USER=admin

# REQUIRED, no default: the stack refuses to boot without it.
# Generate: openssl rand -base64 32   (or run scripts/generate-env.sh)
POSTGRES_PASSWORD=

# REQUIRED for production (api/migrate), min 32 bytes (256 bits).
# Maps to auth:IssuerSigningKey via compose (auth__IssuerSigningKey).
# Generate: openssl rand -base64 48   (or run scripts/generate-env.sh)
AUTH_ISSUER_SIGNING_KEY=

# Browser-reachable API URL (issue #271). The web container renders this to
# /config.js at startup and the UI prefers it over the build-time fallback
# below — repointing the backend needs a restart, never a rebuild.
# Default when unset: http://localhost:8080
# An explicitly emptied value fails fast at container start.
#
# SERVER: must be the public frontend origin itself
# (e.g. API_BASE_URL=https://1-2-3-4.sslip.io). Browsers then stay
# same-origin and the web nginx proxies /api/* to the api container —
# no CORS issues and Secure auth cookies just work.
API_BASE_URL=http://localhost:8080

# Build-time fallback for the same URL, baked into the web image.
# Defaults to API_BASE_URL when unset, so Coolify builds stay correct.
# VITE_API_BASE_URL=

# SERVER: must be the same public origin as API_BASE_URL.
# Production refuses to boot with an empty list (fail-fast in Program).
# Local dev ignores this (Development uses a permissive CORS policy).
CORS_ALLOWED_ORIGIN=http://localhost:3000

# SERVER: Production (single-server path applies migrations on boot,
# asiki-style; see docs/deployment.md). Local dev is forced back to
# Development by docker-compose.override.yml, so keeping Production here is
# safe for both.
ASPNETCORE_ENVIRONMENT=Production

# Apply pending EF Core migrations on api boot (default true = single-server
# path). The strict `production` profile (migrate job + api-prod) keeps Boot
# off — see docs/production-runbook.md.
# BOOT_APPLY_MIGRATIONS=true
# BOOT_RUN_SEEDERS=false

# Local host ports (docker-compose.override.yml only, never on the server).
HTTP_PORT=3000

# Seq (structured logging)
# Browse logs at http://localhost:${SEQ_PORT}
SEQ_PORT=5341

# --- Agent swarm (separate docker-compose.swarm.yml, local only, never deployed) ---
# Hardened (issue #357): the swarm runs as non-root `swarm` and never
# bind-mounts host credentials. Both tokens below are env-passed.
# GitHub token for gh + git push inside the container.
# Scopes: repo, workflow. Print the current one with: gh auth token
GH_TOKEN=

# opencode API key (opencode.ai/auth) for agents inside the container.
# Without it the dispatcher starts but agents cannot call the AI service.
OPENCODE_API_KEY=

# GID of the host `docker` group for least-privilege socket access
# (Linux: `getent group docker`, usually 999; Docker Desktop: default works).
# DOCKER_GID=999

# Optional swarm overrides
# SWARM_REPO_URL=https://github.com/osk4rm/MES.git
# SWARM_REPO_BRANCH=master
# SWARM_AUTOSTART_DISPATCHER=1
# DASHBOARD_PORT=5178
